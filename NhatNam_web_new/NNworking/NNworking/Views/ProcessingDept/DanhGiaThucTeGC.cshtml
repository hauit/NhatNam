        var G57Z = $("#txt_G57_Z").val();// == '' ? '0' : $("#txt_G57_Z").val();
        var G58X = $("#txt_G58_X").val();// == '' ? '0' : $("#txt_G58_X").val();
        var G58Y = $("#txt_G58_Y").val();// == '' ? '0' : $("#txt_G58_Y").val();
        var G58Z = $("#txt_G58_Z").val();// == '' ? '0' : $("#txt_G58_Z").val();
        var G59X = $("#txt_G59_X").val();// == '' ? '0' : $("#txt_G59_X").val();
        var G59Y = $("#txt_G59_Y").val();// == '' ? '0' : $("#txt_G59_Y").val();
        var G59Z = $("#txt_G59_Z").val();// == '' ? '0' : $("#txt_G59_Z").val();

        var dataG54 = {
            G54X,
            G54Y,
            G54Z,
            G55X,
            G55Y,
            G55Z,
            G56X,
            G56Y,
            G56Z,
            G57X,
            G57Y,
            G57Z,
            G58X,
            G58Y,
            G58Z,
            G59X,
            G59Y,
            G59Z
            }

        var key = partID +optionID +order +MachineId +Shift +Date;
        var existed = 0;
        for (var j = 0; j < arrayStock.length; j++) {
            if (arrayStock[j][0] == key) {
                existed = 1;
                break;
            }
        }

        if (existed == 0) {
            var dataStock = [
                key,
                G54X,
                G54Y,
                G54Z,
                G55X,
                G55Y,
                G55Z,
                G56X,
                G56Y,
                G56Z,
                G57X,
                G57Y,
                G57Z,
                G58X,
                G58Y,
                G58Z,
                G59X,
                G59Y,
                G59Z
            ]

            arrayStock.push(dataStock);
        }
        array.push(JSON.stringify(dataG54));
        if(id == 1)
        alert("OK!");
    }
</script>

