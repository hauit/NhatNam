        var G55X = $("#txt_G55_X").val();// == '' ? '0' : $("#txt_G55_X").val();
        var G55Y = $("#txt_G55_Y").val();// == '' ? '0' : $("#txt_G55_Y").val();
        var G55Z = $("#txt_G55_Z").val();// == '' ? '0' : $("#txt_G55_Z").val();
        var G56X = $("#txt_G56_X").val();// == '' ? '0' : $("#txt_G56_X").val();
        var G56Y = $("#txt_G56_Y").val();// == '' ? '0' : $("#txt_G56_Y").val();
