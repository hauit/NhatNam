        function ListMachine(data) {
            var list_Shift = '';
            list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca 1" onclick="ShiftValue(\'T1\',\'' + data + '\')"> ';
            list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca 2" onclick="ShiftValue(\'T2\',\'' + data + '\')"> ';
            list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca 3" onclick="ShiftValue(\'T3\',\'' + data + '\')"> ';
            list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca ngày" onclick="ShiftValue(\'T1\',\'' + data + '\')"> ';
            list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca đêm" onclick="ShiftValue(\'T2\',\'' + data + '\')"> ';
            list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca HC" onclick="ShiftValue(\'T0\',\'' + data + '\')"> ';
            list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="All" onclick="ShiftValue(\'\',\'' + data + '\')"> ';
            $("#MachineGroupButton").html(list_Shift);

        }

        function loadGroupMachine() {
            $.ajax({
                url: '@Url.Action("ListMachineGroup", "ProcessingDept")',
                dataType: 'Json',
                type: 'GET',
                data: '',
                cache: false,
                success: function (data) {
                    var GroupMachineBT = "";
                    $.each(data, function (i, val) {
                        GroupMachineBT += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="' + val + '" name=""  value="' + val + '" onclick="ListMachine(\'' + val + '\')"> ';
                    });
                    $("#MachineGroupButton").html(GroupMachineBT);
                },
            });
        }


        var MachineId = '';
        var Shift = '';
        var group = '';
        function ShiftValue(data, group) {
            Shift = data;
            $("#ShiftButton").append("<br/>" + Shift);
            $.ajax({
                url: '@Url.Action("ListMachineByGroup", "ProcessingDept")',
                data: { 'Group': group, 'shift': Shift },
                dataType: 'JSON',
                type: 'POST',
                cache: false,
                success: function (data) {
                    var a = '';
                    if (data != null) {
                        $.each(data, function (i, val) {
                            if (val.HavePlan == true) {
                                a += '<input class="btn btn-green" style="margin-top: 10px;background-color: red;" type="Button" tabindex="" id="' + val.MachineID + '" name=""  value="' + val.MachineID + '" onclick="SelectedMachine(\'' + val.MachineID + '\')"> ';
                                return;
                            }

                            a += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="' + val.MachineID + '" name=""  value="' + val.MachineID + '" onclick="SelectedMachine(\'' + val.MachineID + '\')"> ';
                        });
                        $("#MachineGroupButton").html(a);
                    }
                    else {
                        $("#MachineGroupButton").html(nulldata);
                    }
                },
            });
        }
        function SelectedMachine(data) {
            MachineId = data;
            GetPlanOfMachine();
            var msg = '<h3><span style="color:red;">Bạn đang xem kế hoạch của máy: ' + MachineId + '</span></h3>';
            $("#MachineGroupButtonHistory").html(msg);
        }

        function GetPlanOfMachine() {
            var fromDate = getFromDateValue();
            var toDate = getToDateValue();
            var selectedMachine = $("#MachineList").dxAutocomplete("instance").option('value');
            if (selectedMachine == null || selectedMachine == '')
            {
                MachineId = group;
            }

            var workID = $("#WorkIDList").dxAutocomplete("instance").option('value');
            $.ajax({
                url: '@Url.Action("GetKadouTimeTotal", "ProcessingDept")',
                data: { 'Shift': Shift, 'MachineID': MachineId, 'fromDate': fromDate, 'toDate': toDate, 'workID': workID },
                dataType: 'JSON',
                type: 'GET',
                cache: false,
                success: function (data) {
                    if (data.Status != "OK")
                    {
                        alert(data.Values);
                        return;
                    }

                    DrawChart(data);
                    BindDataToGrid(data);
                },
            });
        }

        function BindDataToGrid(data) {
            var tile = {
                S_Host: "Tile(%)",
                RunningTime: (data.KadouTime[1].RunningTime * 100 / data.KadouTime[0].RunningTime).toFixed(2),
                StopTime: (data.KadouTime[1].StopTime * 100 / data.KadouTime[0].StopTime).toFixed(2),
                ALRMTime: (data.KadouTime[1].ALRMTime * 100 / data.KadouTime[0].ALRMTime).toFixed(2)
            };
            data.KadouTime.push(tile);
            $("#dxDataGrid").dxDataGrid({
                dataSource: data.KadouTime,
                showBorders: true,
                paging: {
                    pageSize: 20
                },
                pager: {
                    showPageSizeSelector: true,
                    allowedPageSizes: [5, 10, 20],
                    showInfo: true
                },
                export: {
                    enabled: true,
                    fileName: "ExportedData",
                    allowExportSelectedData: true
                },
            });
        }

        function DrawChart(data) {
            $("#chart").dxChart({
                dataSource: data.KadouTime,
                title: "So sánh WTS với Kadou máy " + MachineId,
                commonSeriesSettings: {
                    argumentField: "S_Host",
                    type: "bar",
                    hoverMode: "allArgumentPoints",
                    selectionMode: "allArgumentPoints",
                    label: {
                        visible: true,
                        format: {
                            type: "fixedPoint",
                            precision: 0
                        }
                    }
                },
                series: [
                    { valueField: "ALRMTime", name: "ALRM" },
                    { valueField: "RunningTime", name: "Running" },
                    { valueField: "StopTime", name: "Stop" }
                ],
                legend: {
                    verticalAlignment: "bottom",
                    horizontalAlignment: "center"
                },
                "export": {
                    enabled: true
                },
                onPointClick: function (e) {
                    e.target.select();
                }
            });
        }

        function getFromDateValue() {
            var a = $("#dateFromDate").dxDateBox("instance").option("value");
            return a;
        }

        function getToDateValue() {
            var a = $("#dateToDate").dxDateBox("instance").option("value");
            return a;
        }
    </script>



