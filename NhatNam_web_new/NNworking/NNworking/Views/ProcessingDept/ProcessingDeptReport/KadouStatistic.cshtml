


<div class="box box-body">
    <div class="col-lg-6">
        <table>
            <tr>
                <td style="padding-left: 10px;width: 100px;">
                    Từ Ngày:
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().DateBox()
                        .Value(DateTime.Now)
                        .ID("dateFromDate")
                    )
                </td>
                <td style="padding-left: 10px;width: 100px;">
                    Nhóm máy:
                </td>
                <td style="padding-left: 10px;width: 150px;">
                    <div id="GroupMachineList"></div>
                </td>
                <td style="padding-left: 10px;width: 100px;">
                    Máy:
                </td>
                <td style="padding-left: 10px;width: 150px;">
                    <div id="MachineList"></div>
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().Button()
                        .Text("Xem")
                        .ID("btnView")
                        .Type(ButtonType.Normal)
                        .Width(90)
                        .OnClick("GetPlanOfMachine")
                    )
                </td>
            </tr>
            <tr>
                <td style="padding-left: 10px;width: 100px;">
                    Đến Ngày:
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().DateBox()
                        .Value(DateTime.Now)
                        .ID("dateToDate")
                    )
                </td>
                <td style="padding-left: 10px;width: 100px;">
                    Ca:
                </td>
                <td style="padding-left: 10px;width: 150px;">
                    <div id="ShiftList"></div>
                </td>
                <td style="padding-left: 10px;width: 100px;">
                    Mã cv:
                </td>
                <td style="padding-left: 10px;width: 150px;">
                    <div id="WorkIDList"></div>
                </td>
                <td style="padding-left: 10px;"></td>
            </tr>
        </table>
    </div>
