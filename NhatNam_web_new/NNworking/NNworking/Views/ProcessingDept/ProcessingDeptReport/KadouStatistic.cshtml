        var shiftList = new Array();
        var groupMachineList = new Array();
        $.ajax({
            url: '@Url.Action("ListMachineGroup", "ProcessingDept")',
            dataType: 'Json',
            type: 'GET',
            data: '',
            cache: false,
            success: function (data) {
                groupMachineList = data;
                var groupMachine = $("#GroupMachineList").dxAutocomplete("instance");
                if(groupMachine != null)
                {
                    groupMachine.option('dataSource', groupMachineList);
                }
            },
        });

        $(function () {
            shiftList = ["T1", "T2", "T3", "T0"];
            $("#ShiftList").dxAutocomplete({
                dataSource: shiftList,
                placeholder: "Chọn ca",
                onValueChanged: function (data) {
                    Shift = data.value;
                }
            });

            $("#GroupMachineList").dxAutocomplete({
                dataSource: groupMachineList,
                placeholder: "Nhóm máy",
                onValueChanged: function (data) {
                    group = data.value;
                    $.ajax({
                        url: '@Url.Action("ListMachineByGroup", "ProcessingDept")',
                        data: { 'Group': group, 'shift': Shift },
                        dataType: 'JSON',
                        type: 'POST',
                        cache: false,
                        success: function (data) {
                            var machineList = new Array();
                            $.each(data, function (i, val) {
                                machineList.push(val.MachineID);
                            });
                            $("#MachineList").dxAutocomplete("instance").option('dataSource', machineList);
                        },
                    });
                }
            });

            $("#MachineList").dxAutocomplete({
                dataSource: '',
                placeholder: "Chọn Máy",
                onValueChanged: function (data) {
                    MachineId = data.value;
