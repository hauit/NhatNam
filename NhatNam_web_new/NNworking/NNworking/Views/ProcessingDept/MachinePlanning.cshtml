
@{
    ViewBag.Title = "Kế hoạch làm việc các bộ phận gián tiếp";
}

<div class="box box-body">
    <div class="col-lg-5">
        <table>
            <tr>
                <td>
                    Từ ngày:
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().DateBox()
                        .Value(DateTime.Now)
                        .ID("dateFromDate")
                    )
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().Button()
                        .Text("Xem")
                        .ID("btnView")
                        .Type(ButtonType.Normal)
                        .Width(90)
                        .OnClick("ViewData")
                    )
                </td>
                <td style="padding-left: 10px;">
                    Bộ phận:
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().SelectBox()
                        .ID("cbDept")
                        .DataSource(new[] { "", "Xưởng", "Via", "Kiểm tra", "Cưa", "Khoan tay", "Hàn", "Mạ", "Đánh bóng", "Đánh bóng", "Rửa dầu", "F3", "In ép", "Đóng số" })
                        .SearchEnabled(true)
                        .Width(200)
                    )
                </td>
            </tr>
            <tr>
                <td>
                    Đến ngày:
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().DateBox()
                        .Value(DateTime.Now)
                        .ID("dateToDate")
                    )
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().Button()
                        .Text("Import")
                        .ID("btnImport")
                        .Type(ButtonType.Normal)
                        .Width(90)
                    )
                </td>
                <td style="padding-left: 10px;">
                    Ca:
                </td>
                <td style="padding-left: 10px;">
                    @(Html.DevExtreme().SelectBox()
                        .ID("cbShift")
                        .DataSource(new[] { "", "Ca 1", "Ca 1", "Ca 2", "Ca 3", "Ca HC", "Ca ngày", "Ca đêm" })
                        .SearchEnabled(true)
                        .Width(200)
                    )
                </td>
            </tr>
        </table>
    </div>

    <div class="col-lg-7">
        <ul>
            <li>
                <a href="#">Đăng kí thời gian làm via</a>
            </li>
            <li>
                <a href="@Url.Action("UrgentProcessingPlan", "ProcessingDept")">Danh sách hàng cần gấp</a>
            </li>
        </ul>
    </div>
</div>
@(Html.DevExtreme().DataGrid<NNworking.Models.C242_MachinePlanning>()
