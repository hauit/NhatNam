        if (rowElement.rowType != "data") {
            return;
        }

        if (rowElement.data.Note.indexOf("CAN GAP") != -1) {
            rowElement.rowElement.css("background", "#93D7F4");
        }
    }

    var visible = false;
    function expandGrid(e) {
        visible = visible == false ? true : false;
        $('#dxDataGrid').dxDataGrid('columnOption', 'ThoiHan1', 'visible', visible);
        $('#dxDataGrid').dxDataGrid('columnOption', 'TGGC1', 'visible', visible);
        $('#dxDataGrid').dxDataGrid('columnOption', 'TGGL1', 'visible', visible);
        $('#dxDataGrid').dxDataGrid('columnOption', 'PJ61', 'visible', visible);
        $('#dxDataGrid').dxDataGrid('columnOption', 'PZE1', 'visible', visible);
