<script>
    var Shift = '';
    var MachineId = '';
    DisplayChatBox('@Url.Action("SendMessageToOther", "AllDept")');
    var group = 'MachineID';
    GetUser(group, '@Url.Action("ListAvailableUser", "AllDept")');

    $(document).ready(function () {
        var popupStatus = 0;
        /** các hàm dùng chug cho popup**/
        $(this).keydown(function (event) {
            if (event.which == 27) {
                disablePopup();
            }
        });

        $("#background-popup").click(function () {
            //$("#banga").html('<td><b>Bàn gá:</b></td> <td>' + palet + '</td>');
            disablePopup();
        });

        function loadBackgroundToPopup() {
            $("#background-popup").css("opacity", "0.2");
            $("#background-popup").fadeIn(200);
        }

        function disablePopup() {
            if (popupStatus == 1) {
                $("#ShiftButton").fadeOut(200);
                $("#MachineGroupButton").fadeOut(200);
                $("#OptionIDButtonTotal").fadeOut(200);
                $("#OptionIDButton").fadeOut(200);
                $("#background-popup").fadeOut(200);
                popupStatus = 0;
            }
        }

        /** load các popup của các phần **/
        function loadShiftPopup() {
            if (popupStatus == 0) {
                $("#ShiftButton").fadeIn(200);
                loadBackgroundToPopup();
                popupStatus = 1;
            }
        }

        function loadMachineGroupPopup() {
            if (popupStatus == 0) {
                $("#MachineGroupButton").fadeIn(200);
                loadBackgroundToPopup();
                popupStatus = 1;
            }
        }

        /** các hàm gọi sự kiện click **/
        $("#ShiftBT").click(function () {
            loadShiftPopup();
        });

        $("#btnView").click(function () {
            loadMachineGroupPopup();
        });

        // lấy lại kế hoạch sau 1 khoảng thời gian

        //setInterval(function () {
        //    if (MachineId != '') {
        //        GetPlanOfMachine();
        //    }
        //}, 1000 * 30);
    })

    function loadGroupMachine() {
        $.ajax({
            url: '@Url.Action("ListMachineGroup", "ProcessingDept")',
            dataType: 'Json',
            type: 'GET',
            data: '',
            cache: false,
            success: function (data) {
                var GroupMachineBT = "";
                $.each(data, function (i, val) {
                    GroupMachineBT += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="' + val + '" name=""  value="' + val + '" onclick="ListMachine(\'' + val + '\')"> ';
                });
                $("#MachineGroupButton").html(GroupMachineBT);
            },
        });
    }

    function getDateValue() {
        var a = $("#dateDate").dxDateBox("instance").option("value");
        return a;
    }

    function ListMachine(data) {
        var group = data;
        $("#MachineGroupButton").append("<br/>" + MachineId);
        var Date = getDateValue();
        var list_Shift = '';
        list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca 1" onclick="ShiftValue(\'T1\',\'' + group + '\')"> ';
        list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca 2" onclick="ShiftValue(\'T2\',\'' + group + '\')"> ';
        list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca 3" onclick="ShiftValue(\'T3\',\'' + group + '\')"> ';
        list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca ngày" onclick="ShiftValue(\'T1\',\'' + group + '\')"> ';
        list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca đêm" onclick="ShiftValue(\'T2\',\'' + group + '\')"> ';
        list_Shift += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="Shift" name="" value="Ca HC" onclick="ShiftValue(\'T0\',\'' + group + '\')"> ';

        $("#MachineGroupButton").html(list_Shift);
    }
    
    function ShiftValue(data, group) {
        GetPlanOfMachine(data, group);
        $("#ShiftButton").append("<br/>" + Shift);
    }

    function GetPlanOfMachine(shift, group) {
        var date = getDateValue();
        $.ajax({
            url: '@Url.Action("GetUrgentProcessingPlan", "ProcessingDept")',
            data: { 'Shift': shift, 'group': group, 'date': date },
            dataType: 'JSON',
            type: 'GET',
            cache: false,
            success: function (data) {
                if (data.Status != "OK") {
                    alert(data.Values);
                    return;
                }

                $('#dxDataGrid').dxDataGrid('instance').option('dataSource', data.Values);
            },
        });


    }
</script>

