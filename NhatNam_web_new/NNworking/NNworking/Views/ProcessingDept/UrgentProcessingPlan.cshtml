    <div id="dataGrid">
        @(Html.DevExtreme().DataGrid<NNworking.Models.sp_GetMachinePlanForFactory_TGTC_Result1>()
            .DataSource(Url.Action("GetMachinePlanForFactory", "ProcessingDept", new { Shift = "", MachineID = "", date = DateTime.Now })//.LoadAction("GetMachinePlanForFactory").Controller("ProcessingDept")
                                                                                                                                         //.LoadParams(new { Shift = new JS("getShift"), MachineID = new JS("getMachineID"), date = new JS("getDateValue") })
                                                                                                                                         //.Controller("ProcessingDept")
                                                                                                                                         //.LoadAction("GetMachinePlanForFactory")
                                                                                                                                         //.LoadParams(new { Shift ="", MachineID = new JS("getMachineID"), date = new JS("getDateValue") })
            )
            .ID("dxDataGrid")
            .Selection(select => select.Mode(SelectionMode.Multiple))
            .Paging(page => page.PageSize(10))
            .Pager(pager => pager.ShowPageSizeSelector(true)
                .ShowInfo(true)
                .AllowedPageSizes(new List<int> { 10, 20, 30 })
            )
            .Sorting(sort => sort.Mode(GridSortingMode.Multiple)
                .DescendingText("Máy_GC")
            )
            .ColumnAutoWidth(true)
            .FilterRow(fil => fil.Visible(true))
            .FilterPanel(fi => fi.Visible(true))
            .SearchPanel(search => search.Visible(true)
                .HighlightSearchText(true)
                .Width(500)
            )
            //.HeaderFilter(headFil => headFil.Visible(true))
            .ShowColumnHeaders(true)
            .ShowRowLines(true)
            .RemoteOperations(true)
            .Columns(col =>
            {
                col.AddFor(m => m.TTGC).Width(40);
                col.AddFor(m => m.Phoi).Caption("P").Width(40);
                col.AddFor(m => m.Fille).Caption("CT").Width(40);
                col.AddFor(m => m.Dao).Caption("D").Width(40);
                col.AddFor(m => m.CBJig).Caption("J").Width(40);
                col.AddFor(m => m.NG_Old).Caption("NG").Width(40);
                col.AddFor(m => m.OK_Old).Caption("OK").Width(40);
                col.AddFor(m => m.Fac_TTFile).Caption("TT File");
                col.AddFor(m => m.TinhTrang).Caption("TT Phôi").Width(40);
                col.AddFor(m => m.Fac_GCXong).Caption("GC xong");
                col.AddFor(m => m.Fac_GCDo).Caption("GC dở");
                col.AddFor(m => m.Note);
                col.AddFor(m => m.K).Caption("Mã");
                col.AddFor(m => m.Ký_hiệu_chi_tiết);
                col.AddFor(m => m.Số_Order).Caption("Order");
                col.AddFor(m => m.TTNC).Caption("NC");
                col.AddFor(m => m.Slg_lệnh).Caption("SLL");
                col.AddFor(m => m.ThoiHan1).Caption("Thời hạn").Visible(false);
                col.AddFor(m => m.TGGC1).Caption("TGGC").Visible(false);
                col.AddFor(m => m.TGGL1).Caption("TGGL").Visible(false);
                col.AddFor(m => m.PJ61).Visible(false);
                col.AddFor(m => m.PZE1).Visible(false);
                col.AddFor(m => m.PBJ1).Visible(false);
                col.AddFor(m => m.PU71).Visible(false);
                col.AddFor(m => m.TgTotal).Caption("Tổng thời gian").Visible(false);
                col.AddFor(m => m.TGTC).Visible(false);
                col.AddFor(m => m.DK_may).Visible(false);
                col.AddFor(m => m.Fac_NgayHTtheoKH1).Caption("Ngày HT theo KH").Visible(false);
                col.AddFor(m => m.Fac_NGTruoc).Caption("NC trước").Visible(false);
            })
            .Editing(e => e
                //.AllowAdding(true)
                .AllowUpdating(true)
                //.AllowDeleting(true)
                .Mode(GridEditMode.Cell)
            )
            .OnRowValidating("ValidateRow")
            .OnRowPrepared("onRowPrepared")
        )


    </div>
</section>


