    var CheckList = new Array();
    function GenerateDataForCheckStandTime(id, code) {
        DisplayManualExcutionChecking();
        CheckList = new Array();
        $.ajax({
            url: '@Url.Action("GetDataForCheckStandTime", "ProcessingDept")',
            type: "POST", //JSON
            dataType: "json",
            cache: false,
            data: { 'plannID': id, 'wtsID': code },
            success: function (data) {
                if (data.Status != "OK") {
                    alert(data.Values);
                    return;
                }
                var list = new Array();
                CheckList = data.CheckList;
                var htmlCode = data.Values + '<input class="btn VP" style="margin - top: 10px; " type="Button" tabindex="" id="Show_CheckThaoTac" name="" value="Xong" onclick="CheckStandTimeFinish(' + id + ')">';
                $("#ManualExcutionChecking").html('');
                $("#ManualExcutionChecking").html(htmlCode);
            }
        });
    }

    function CheckStandTimeFinish(plannID) {
        var staffID = $("#CheckThaoTac_StaffID").val();
        var pass = $("#CheckThaoTac_Pass").val();
        var leader = $("#LeaderConfirm").val();
        if (leader == '')
        {
            alert("Trưởng nhóm không được để trống");
            return;
        }

        var expectedProcessingTime = $("#ExpectedProcessingTime").dxDateBox("instance").option('value');
        var listResult = new Array();
        for (var i = 0; i < CheckList.length; i++)
        {
            var value = $("#CheckingStandTime_" + CheckList[i].WorkID + "_" + CheckList[i].Sub_WorkID).is(":checked");
            var data = [CheckList[i].WorkID, CheckList[i].Sub_WorkID, value.toString()];
            listResult.push(JSON.stringify(data));
        }

        $.ajax({
            url: '@Url.Action("CheckStandTimeFinish", "ProcessingDept")',
            type: "POST", //JSON
            dataType: "json",
            cache: false,
            data: { 'plannID': plannID, 'listResult': listResult, 'leader': leader, 'expectedProcessingTime': expectedProcessingTime, 'staffID': staffID, 'pass': pass },
            success: function (data) {
                if (data.Status != "OK") {
                    alert(data.Values);
                    return;
                }

                HidenManualExcutionChecking();
            }
        });
    }

    function TTTraDao(container, options) {
        var row = options.data;
        var id = row.ID;
        var ToolID = row.ToolDataID;
        var ToolName = row.ToolName;
        var ToolMakerName = row.MakerToolName;
        var ReturnTool = row.ReturnTool;
        var Quantity = row.Quantity;
        var Acception = row.Acception;
        var BorrowNo = row.BorrowNo;

        $('<div id="dxButton_TraDao_' + id + '" /><a href="#" onclick ="SendReturnToolItem(' + id + ',\'' + ToolID + '\',\'' + ToolName + '\',\'' + ToolMakerName + '\',\'' + Quantity + '\',\'' + ReturnTool + '\',\'' + Acception + '\',\'' + BorrowNo + '\')">Trả dao</a></div>').appendTo(container);

    }

    function SendReturnToolItem(id, ToolID, ToolName, ToolMakerName, Quantity, ReturnTool, Acception, BorrowNo)
    {
        var data = {
            ToolID: ToolID,
            ToolName: ToolName,
            ToolMakerName: ToolMakerName,
            Quantity: Quantity,
            ReturnTool: ReturnTool,
            ReturnTime: null,
            Acception: Acception,
            AcceptTime: null,
            BorrowNo: BorrowNo
        };

        $.ajax({
            url: '@Url.Action("SendReturnToolItem", "ProcessingDept")',
            dataType: 'JSON',
            type: 'POST',
            cache: false,
            data: { 'data': data },
            success: function (data) {
                if (data.Status != "OK") {
                    alert("Không lấy được danh sách dao. Vui lòng liên hệ với NV PM. " + data.Value);
                    return;
                }

                alert("OK");
            },
        });
    }

