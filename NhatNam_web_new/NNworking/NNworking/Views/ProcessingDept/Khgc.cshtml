    function SendListToolForBorrow()
    {
        var listTool = new Array();
        var TimeNeedToGet = $("#TimeMuon").dxDateBox("instance").option("value").toISOString();
        var borrowNoData = { MachineID: MachineId, PartNo: Part, OptionID: NC, Shift: Shift, TimeNeedToGet: TimeNeedToGet };
        for(var i = 0; i < newToolArray.length; i ++)
        {
            var tenDao = $("#TenDao_" + i).dxAutocomplete("instance").option("value");// $("#TenDao_" + i).val();
            var muonMoi = $("#MuonMoi_" + i).is(":checked");
            var muonThem = $("#MuonDB_" + i).is(":checked");
            var slg = $("#Quantity_" + i).val();
            var note = $("#Note_" + i).val();
            var KHDao = $("#KhDao_" + i).html();
            if (tenDao == null || (muonMoi == false && muonThem == false))
            {
                continue;
            }

            if (slg <= 0 || !$.isNumeric(slg))
            {
                alert("Chưa nhập số lượng cho dao " + tenDao);
                return;
            }

            if (muonThem == true && note == "")
            {
                alert(tenDao + " mượn thêm thì cần nhập ghi chú.");
                return;
            }

            var tool = { MakerToolName: tenDao, ToolName: KHDao, BorrowNew: muonMoi, BorrowMore: muonThem, Quantity: slg, Note: note };
            listTool.push(tool);
        }

        if (listTool.length == 0)
        {
            return;
        }

        $.ajax({
            url: '@Url.Action("SendListToolForBorrow", "ProcessingDept")',
            dataType: 'JSON',
            type: 'POST',
            cache: false,
            data: { 'toolBorrow': borrowNoData, 'listDetail': listTool },
            success: function (data) {
                if (data.Status != "OK") {
                    alert("Không lấy được danh sách dao. Vui lòng liên hệ với NV PM. " + data.Value);
                    return;
                }

            },
        });
    }

    function AddTimeMuon(idTag) {
