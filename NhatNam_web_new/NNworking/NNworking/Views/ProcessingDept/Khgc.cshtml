    function GetPlanOfMachine() {
        var date = getDateValue();
        var url = '@Url.Action("GetMachinePlanForFactory", "ProcessingDept")' + "?Shift=" + Shift + "&MachineID=" + MachineId + "&date=" + date;
        $.ajax({
            url: '@Url.Action("GetMachinePlanForFactory", "ProcessingDept")',
            data: { 'Shift': Shift, 'MachineID': MachineId, 'date': date },
            dataType: 'JSON',
            type: 'GET',
            cache: false,
            success: function (data) {
                var a = $('#dxDataGrid').dxDataGrid('instance');
                a.option('dataSource', data);
            },
        });

        $.ajax({
            url: '@Url.Action("GetPartNeedConfirmBy0194", "ProcessingDept")',
            data: { 'Shift': Shift, 'MachineID': MachineId, 'date': date },
            dataType: 'JSON',
            type: 'GET',
            cache: false,
            success: function (data) {
                var html = '';
                if (data.length == 0) {
                    $("#ListPartNeedConfirmBy0194").html(html);
                    return;
                }

                html += '     <table>                                    ';
                html += '     <tr>                                       ';
                html += '         <td colspan="2" style="padding-left: 10px;">       ';
                html += ' Danh sách chi tiết cần kiểm soát việc gãy dao endchip25. Đề nghị báo lại cho trưởng nhóm và Mr.Thái 0194 trước khi gia công ';
                html += '         </td>                                  ';
                html += '     </tr>                                      ';

                html += '     <tr>                                       ';
                html += '         <td style="padding-left: 10px;">       ';
                html += ' Chi tiết ';
                html += '         </td>                                  ';
                html += '         <td style="padding-left: 10px;">       ';
                html += ' Nguyên công ';
                html += '         </td>                                  ';
                html += '     </tr>                                      ';

                $.each(data, function (i, val) {
                    html += '     <tr>                                       ';
                    html += '         <td style="padding-left: 10px;">       ';
                    html += val.PartID;
                    html += '         </td>                                  ';
                    html += '         <td style="padding-left: 10px;">       ';
                    html += val.OptionID;
                    html += '         </td>                                  ';
                    html += '     </tr>                                      ';
                });
                html += ' </table>                                       ';
                $("#ListPartNeedConfirmBy0194").html(html);
            },
        });
    }
</script>

