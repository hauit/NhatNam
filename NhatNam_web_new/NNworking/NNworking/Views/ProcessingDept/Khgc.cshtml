    function ThaoTac(container, options) {
        var id = options.data.ID;
        var row = options.data;
        var checkedNumber = options.data.CheckedNumber;
        var checkingItemNumber = options.data.CheckingItemNumber;
        var maxCheckingNumber = options.data.MaxNumber;

        var grid = $("dxDataGrid").dxDataGrid("instance");
        if (options.data.GiaThanh == 1) {
            if (checkedNumber > 0 && checkedNumber < maxCheckingNumber) {
                $("<div id='dxButton_ThaoTac_" + id + "'/>").dxButton({
                    text: 'Thao tác',
                    stylingMode: "outlined",
                    type: "danger",
                    onClick: function () {
                        GenerateDataForCheck(row, true);
                    }
                }).appendTo(container);

                AddElementAttribute(id, "style", "background-color: #fff;color: #d43f3a;border: 1px solid #d43f3a;");
                return;
            }

            if (checkedNumber >= maxCheckingNumber && maxCheckingNumber != 0) {
                $("<div id='dxButton_ThaoTac_" + id + "'/>").dxButton({
                    text: 'Thao tác',
                    stylingMode: "text",
                    type: "danger",
                    onClick: function () {
                        GenerateDataForCheck(row, true);
                    }
                }).appendTo(container);

                AddElementAttribute(id, "style", "background-color: #fff;color: #d43f3a;border: 0px solid #d43f3a;");
                return;
            }

            $("<div id='dxButton_ThaoTac_" + id + "'/>").dxButton({
                text: 'Thao tác',
                stylingMode: "contained",
                type: "danger",
                onClick: function () {
                    GenerateDataForCheck(row, true);
                }
            }).appendTo(container);
            return;
        }

        if (checkedNumber > 0 && checkedNumber < maxCheckingNumber) {
            $("<div id='dxButton_ThaoTac_" + id + "'/>").dxButton({
                text: 'Thao tác',
                stylingMode: "outlined",
                type: "success",
                css: "outlined",///////
                onClick: function () {
                    GenerateDataForCheck(row, false);
                }
            }).appendTo(container);

            AddElementAttribute(id, "style", "background-color: #fff;color: #5cb85c;border: 1px solid #398439;");
            return;
        }

        if (checkedNumber >= maxCheckingNumber && maxCheckingNumber != 0) {
            $("<div id='dxButton_ThaoTac_" + id + "'/>").dxButton({
                text: 'Thao tác',
                stylingMode: "text",
                type: "success",
                onClick: function () {
                    GenerateDataForCheck(row, false);
                }
            }).appendTo(container);

            AddElementAttribute(id, "style", "background-color: #fff;color: #5cb85c;border: 0px solid #398439;");
            return;
        }

        $("<div id='dxButton_ThaoTac_" + id + "'/>").dxButton({
            text: 'Thao tác',
            stylingMode: "outlined",
            type: "success",
            onClick: function () {
                GenerateDataForCheck(row, false);
            }
        }).appendTo(container);
        return;
    }

