    function GenerateDataForCheck(e, heightPrice) {
        var id = e.ID;
        DisplayManualExcutionChecking();
        var number = $("#CheckThaoTac_NumberOfPart").val();
        if (number == '') {
            number = 1;
        }

        $.ajax({
            url: '@Url.Action("GetDataForCheckExecution", "ProcessingDept")',
            type: "POST", //JSON
            dataType: "json",
            cache: false,
            data: { 'heightPrice': heightPrice, 'planID': id, 'number': number },
            success: function (data) {
                if (data.Status != "OK") {
                    alert(data.Values);
                    return;
                }
                var html = '';
                html += '<div id="ShowDataForCheck_panel"></div>';
                listHtmlCode = data.HtmlCodes;
                var itemIndex = 0;
                $.each(data.Values, function (i, val) {
                    var start = itemIndex * number;
                    //var finish = val.Index * number;
                    if (i != start || itemIndex >= listHtmlCode.length) {
                        return;
                    }

                    if (val.Key.Checked) {
                        itemIndex += 1;
                        return;
                    }

                    var caption = itemIndex + 1;
                    if (number > 1) {
                        caption = (itemIndex * number + 1) + '-' + ((itemIndex + 1) * number);
                    }

                    itemIndex += 1;
                    if (val.Key.Checkednumber > 0) {
                        html += '<input class="btn btn-green" style="margin-top: 10px;" type="Button" tabindex="" id="CheckNumber_' + val.Index + '" name=""  value="' + caption + '" onclick="ShowDataForCheck(\'' + itemIndex + '\')"> ';
                        return;
                    }

                    html += '<input class="btn btn-green" style="margin-top: 10px;background-color:#d9534f" type="Button" tabindex="" id="CheckNumber_' + val.Index + '" name=""  value="' + caption + '" onclick="ShowDataForCheck(\'' + itemIndex + '\')"> ';
                });

                if (html == '') {
                    html = 'Đã check thao tác đủ cho tất cả các chi tiết';
                }
                //html += '<input class="btn VP" style="margin-top: 10px;" type="Button" tabindex="" id="CheckOK" name=""  value="Xong" onclick="InputManualChecking()"> ';
                $("#ManualExcutionChecking").html(html);
            }
        });

    }

