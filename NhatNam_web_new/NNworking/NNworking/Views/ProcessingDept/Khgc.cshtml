    function onCustomizeColumns(columns) {

        for (var i = 0; i < columns.length; i++) {
            var dataField = columns[i].dataField;
            var mayDotDap = MachineId.toLowerCase().startsWith("tru") || MachineId.toLowerCase().startsWith("viadd");
            switch (dataField) {
                case "Phoi":
                case "Fille":
                case "Dao":
                case "TTFileMem":
                case "CBJig":
                case "TinhTrang":
                    if (mayDotDap) {
                        columns[i].visible = false;
                        break;
                    }

                    columns[i].visible = true;
                case "Fac_GCXong":
                case "Fac_GCDo":
                    if (dataField == 'TTFileMem') {
                        break;
                    }

                    if (MachineId == '@Session["StaffID"].ToString()') {
                        columns[i].allowEditing = true;
                    }
                    break;
                case "Phoidd":
                case "Nesting":
                    if (mayDotDap) {
                        columns[i].visible = true;
                        break;
                    }

                    columns[i].visible = false;
                    break;
            }

        }
    }

