    function AddTextBoxAutocomplete(i) {
        $("#TenDao_" + i).dxAutocomplete({
            dataSource: toolList,
            placeholder: "Tên dao...",
            onValueChanged: function (data) {
                firstName = data.value;
                ChoiceTool(data.value,i);
            }
        });
    }

    function ChoiceTool(makerToolName, stt) {


        for(var i =0; i < toolListInfo.length; i ++)
        {
            if (toolListInfo[i].MakerToolName != makerToolName)
            {
                continue;
            }

            $("#KhDao_" + stt).html(toolListInfo[i].ToolName);
            $("#DuLieu_" + stt).html("Chưa có");
            document.getElementById("MuonMoi_" + stt).checked = false;
            document.getElementById("MuonDB_" + stt).checked = false;
            document.getElementById("MuonDB_" + stt).disabled = true;

            $.ajax({
                url: '@Url.Action("GetExistedTool", "ProcessingDept")',
                type: "POST", //JSON
                dataType: "json",
                cache: false,
                data: { 'makerToolName': makerToolName, 'machineID': MachineId },
                success: function (data) {
                    if (data.Value.length > 0) {
                        $("#DuLieu_" + stt).html("Đã có");
                        document.getElementById("MuonMoi_" + stt).disabled = true;
                        document.getElementById("MuonDB_" + stt).disabled = false;
                    }

                }
            });
            break;
        }
    }

