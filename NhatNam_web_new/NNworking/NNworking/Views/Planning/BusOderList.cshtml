
@{
    ViewBag.Title = "Danh sách đơn hàng";
}


<div class="box box-body">
    @(Html.DevExtreme().Button()
            .Text("Import")
            .ID("btnImport")
            .Type(ButtonType.Normal)
            .Width(150)
    )</br>
</div>

@(Html.DevExtreme().DataGrid<NNworking.Models.View_242_BusOder>()
    .DataSource(ds => ds.WebApi()
        .RouteName("C242_BusOderApi")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("ID")
    )
    .ID("dxBusOderListGrid")
    .Paging(page => page.PageSize(30))
    .Pager(pager => pager.ShowPageSizeSelector(true)
        .ShowInfo(true)
        .AllowedPageSizes(new List<int> { 30, 50, 100, 200 })
    )
    .Sorting(sort => sort.Mode(GridSortingMode.Multiple)
        .DescendingText("ID")
    )
    .ColumnAutoWidth(true)
    .FilterRow(fil => fil.Visible(true))
    .FilterPanel(fi => fi.Visible(true))
    .SearchPanel(search => search.Visible(true)
        .HighlightSearchText(true)
        .Width(500)
    )
    .ShowColumnHeaders(true)
    .ShowRowLines(true)
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.ID);

        columns.AddFor(m => m.BOderNo);

        columns.AddFor(m => m.TempOrder);

        columns.AddFor(m => m.PartNoRRC);

        columns.AddFor(m => m.Date);

        columns.AddFor(m => m.PlanNo);

        columns.AddFor(m => m.PartID);

        columns.AddFor(m => m.Qty);

        columns.AddFor(m => m.Deadline);

        columns.AddFor(m => m.RawQty);

        columns.AddFor(m => m.HelisertQty);

        columns.AddFor(m => m.BlastQty);

        columns.AddFor(m => m.MONo);

        columns.AddFor(m => m.MOQty);

        columns.AddFor(m => m.Started);

        columns.AddFor(m => m.Finished);

        columns.AddFor(m => m.FinishDate);

        columns.AddFor(m => m.Change);

        columns.AddFor(m => m.ChangeDate);

        columns.AddFor(m => m.Imported);

        columns.AddFor(m => m.ImportFrom);

        columns.AddFor(m => m.Note);

        columns.AddFor(m => m.CuttingOrder);

        columns.AddFor(m => m.CuttingStatus);

        columns.AddFor(m => m.Deleted);

        columns.AddFor(m => m.OrderGoc);

        columns.AddFor(m => m.OrderCat);

        columns.AddFor(m => m.NoiCat);

        columns.AddFor(m => m.THVatLieu);

        columns.AddFor(m => m.THPhoi);

        columns.AddFor(m => m.Status);

        columns.AddFor(m => m.Paid);

        columns.AddFor(m => m.PayDate);
    })
    .Editing(e => e
        .AllowAdding(true)
    //.AllowUpdating(true)
    //.AllowDeleting(true)
    )
    .OnInitNewRow("onInitNewRow")
)


<input id="File2" type="file" name="file" class="hide" onchange="ChoiceFilePhu()" />

<script>
    function onInitNewRow(e){
        e.data.ID = 0;
    }

    $(document).on('click', '#btnImport', function () {
        $('#File2').trigger('click');
    });

    function ChoiceFilePhu() {
        var file = $('#File2').get(0);
        var alo = file.files;
        var form = new FormData();
        form.append(alo[0].name, alo[0]);
        $.ajax({
            url: '@Url.Action("ImportBusOderList", "AllDept")',
            type: "POST",
            contentType: false,
            processData: false,
            data: form,
            success: function (data) {
                alert(data.Values);
                if (data.Status != "OK") {
                    return;
                }

                if (data.Errors.length > 0) {
                    DisplayImportError(data.Errors);
                }

                $('#File2').val('');
                SearchByPartNo();
            },
        });
    }
</script>

