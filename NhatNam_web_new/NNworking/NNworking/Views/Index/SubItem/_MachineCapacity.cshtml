<style>
    #charts-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    #charts-container > div {
        width: 100%;
    }
</style>

<table>
    <tr>
        <td>Từ ngày:</td>
        <td style="padding-left: 10px;">
            @(Html.DevExtreme().DateBox()
                .Type(DateBoxType.Date)
                .Value(DateTime.Now.AddDays(-1))
                .ID("fromDate"))
        </td>
        <td style="padding-left: 10px;">
            @(Html.DevExtreme().SelectBox()
                .ID("shiftSelect")
                .DataSource(new[] {
                    new { value = "", text = "Tất cả ca" },
                    new { value = "T1", text = "Ca Sáng" },
                    new { value = "T2", text = "Ca Tối" }
                })
                .ValueExpr("value")
                .DisplayExpr("text")
                .Value("")
            )
        </td>
        <td style="padding-left: 10px;">
            @(Html.DevExtreme().Button()
                .Text("Xem")
                .ID("btnView")
                .Type(ButtonType.Normal)
                .Width(90)
                .OnClick("ViewData"))
        </td>
    </tr>
    <tr>
        <td>Đến ngày:</td>
        <td style="padding-left: 10px;">
            @(Html.DevExtreme().DateBox()
                .Type(DateBoxType.Date)
                .Value(DateTime.Now)
                .ID("toDate"))
        </td>
    </tr>
</table>

<div id="charts-container">
</div>

<script>
    $(document).ready(function() {
        ViewData();
    });

    function getFromDate() {
        return $("#fromDate").dxDateBox("instance").option("value");
    }

    function getToDate() {
        return $("#toDate").dxDateBox("instance").option("value");
    }

    function getSelectedShift() {
        const shiftSelect = $("#shiftSelect").dxSelectBox("instance");
        return shiftSelect.option("value");
    }

    // Load dữ liệu và render charts    
    function ViewData() {
        const fromDate = getFromDate();
        const toDate = getToDate();
        const shift = getSelectedShift();

        $.when(
            $.ajax({
                url: '@Url.Action("sp_242_WTS_DirectWorkPercen", "api/C242_Part")',
                data: { fromdate: fromDate, todate: toDate, shift: shift },
                dataType: 'json'
            }),
            $.ajax({
                url: '@Url.Action("Get", "api/C222_Machine")',
                dataType: 'json'
            })
        ).done(function ([chartResponse], [machinesResponse]) {
            // Xử lý dữ liệu trả về
            const chartData = chartResponse.data || chartResponse;
            const machinesData = machinesResponse.data || machinesResponse;
            const machineData = groupMachinesByType(machinesData);

            // Lấy danh sách máy đang hoạt động
            const errorIds = Array.isArray(machinesData)
                ? machinesData
                    .filter(m => m.Active)
                    .map(m => m.MachineID)
                : [];
            
            // Render charts với dữ liệu đã xử lý
            renderCharts(chartData, errorIds, machineData);
        }).fail(function (err) {
            console.error("Lỗi khi tải dữ liệu:", err);
        });
    }

    // Nhóm máy theo loại (Đúc, Phay, Tiện)
    function groupMachinesByType(machines) {
        const groups = {
            'Duc': [],
            'Phay': [],
            'Tien': []
        };

        // Phân loại máy theo MachineGroup
        machines.forEach(machine => {
            const machineGroup = machine.MachineGroup || '';
            if (machineGroup.includes("Duc")) {
                groups.Duc.push(machine.MachineID);
            } else if (machineGroup.includes("Phay")) {
                groups.Phay.push(machine.MachineID);
            } else if (machineGroup.includes("Tien")) {
                groups.Tien.push(machine.MachineID);
            }
        });

        // Sort máy ID theo số thứ tự
        for (const key in groups) {
            groups[key].sort((a, b) => {
                const numA = a.match(/\d+/);
                const numB = b.match(/\d+/);

                if (numA && numB) {
                    return parseInt(numA[0]) - parseInt(numB[0]);
                }
                if (numA && !numB) return -1;
                if (!numA && numB) return 1;

                return a.localeCompare(b, 'vi');
            });
        }
        return groups;
    }

    // Chia array thành các chunks nhỏ
    function chunkArray(array, chunkSize) {
        const chunks = [];
        for (let i = 0; i < array.length; i += chunkSize) {
            chunks.push(array.slice(i, i + chunkSize));
        }
        return chunks;
    }

    // Xây dựng groups cho charts (mỗi group 20 máy)
    function buildChartGroups(machineData, chartData, errorIds) {
        const result = [];

        // Duyệt qua từng nhóm máy
        Object.keys(machineData).forEach(groupName => {
            const machineIds = machineData[groupName];

            // Chia thành các chunks (20 máy/chart)
            const chunks = chunkArray(machineIds, 20);

            // Map dữ liệu cho từng máy trong chunk
            chunks.forEach((chunk, index) => {
                const data = chunk.map(machineId => {
                    // Tìm dữ liệu existing hoặc tạo default
                    const existing = chartData.find(x => x.MachineID === machineId);
                    return {
                        ...(existing || {
                            MachineID: machineId,
                            C_tghl: 0,
                            C_tgct: 0,
                            C_tgdm: 0
                        }),
                        // Thêm error value cho máy sự cố
                        errorValue: errorIds.includes(machineId) ? 100 : 0
                    };
                });

                result.push({
                    group: groupName,
                    index: index,
                    data: data
                });
            });
        });

        return result;
    }

    // Render tất cả charts vào container
    function renderCharts(chartData, errorIds, machineData) {
        // Clear container và build chart groups
        const $container = $('#charts-container');
        $container.empty();

        const chartGroups = buildChartGroups(machineData, chartData, errorIds);

        // Render từng chart
        chartGroups.forEach((item, i) => {
            const chartId = `chart_${item.group}_${item.index}`;

            $('<div>')
                .attr('id', chartId)
                .appendTo($container);

            // Map nhóm tên sang title tiếng Việt
            const titleMap = {
                Duc: 'TỔ ĐÚC',
                Phay: 'TỔ PHAY',
                Tien: 'TỔ TIỆN'
            };

            renderSingleChart(
                `#${chartId}`,
                item.data,
                titleMap[item.group]
            );
        });
    }

    // Render single chart với DevExtreme
    function renderSingleChart(selector, data, title) {
        // Cấu hình chart: bar chart với 4 series
        $(selector).dxChart({
            dataSource: data,
            title: title,
            commonSeriesSettings: {
                argumentField: "MachineID",
                type: "bar"
            },
            // Series: %TGHL, %TGCT, %Dừng máy, Máy sự cố
            series: [
                { valueField: "C_tghl", name: "%TGHL", color: "#1976d2" },
                { valueField: "C_tgct", name: "%TGCT", color: "#2e7d32" },
                { valueField: "C_tgdm", name: "%Dừng máy", color: "#d32f2f" },
                {
                    valueField: "errorValue",
                    name: "Máy sự cố",
                    color: "#ffd700",
                }
            ],
            legend: { visible: true },
            tooltip: { enabled: true },
            size: { height: 250 },
            adaptiveLayout: { keepLabels: true }
        });
    }
</script>
