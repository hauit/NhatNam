@{
    NNworking.Models.C222_PurChase purchase = (NNworking.Models.C222_PurChase)ViewBag.Purchase;
    ViewBag.Title = "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Phiếu mua hàng</title>
    <style>
        body {
            font-family: "Segoe UI", Tahoma, Arial;
            background: #f4f6f8;
            margin: 0;
            padding: 20px;
        }

        .page {
            max-width: 1100px;
            margin: auto;
            background: #fff;
            padding: 24px;
            border-radius: 8px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
        }

        .header {
            text-align: center;
            margin-bottom: 24px;
        }

            .header h1 {
                margin: 0;
                font-size: 24px;
            }

        .layout {
            display: grid;
            grid-template-columns: 2.5fr 1fr;
            gap: 24px;
        }

        /* ================= FORM ================= */
        .section {
            margin-bottom: 20px;
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 12px;
            border-left: 4px solid #4a90e2;
            padding-left: 8px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

            .form-group label {
                font-size: 13px;
                margin-bottom: 4px;
                color: #555;
            }

            .form-group input,
            .form-group textarea {
                padding: 8px;
                border: 1px solid #ccc;
                border-radius: 4px;
            }

            .form-group.full {
                grid-column: 1 / -1;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }

            table th,
            table td {
                border: 1px solid #ccc;
                padding: 8px;
                font-size: 14px;
            }

            table th {
                background: #f0f2f5;
            }

        .total {
            text-align: right;
            font-weight: bold;
            margin-top: 12px;
        }

        /* ================= TIMELINE ================= */
        .timeline {
            position: relative;
            padding-left: 20px;
        }

            .timeline::before {
                content: "";
                position: absolute;
                left: 6px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #ddd;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
            padding-left: 20px;
        }

            .timeline-item::before {
                content: "";
                position: absolute;
                left: -2px;
                top: 4px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #999;
            }

            .timeline-item.approved::before {
                background: #2ecc71;
            }

            .timeline-item.pending::before {
                background: #f1c40f;
            }

            .timeline-item.rejected::before {
                background: #e74c3c;
            }

        .timeline-title {
            font-weight: 600;
            font-size: 14px;
        }

        .timeline-time {
            font-size: 12px;
            color: #777;
        }

        .timeline-note {
            font-size: 13px;
            margin-top: 4px;
        }
    </style>
</head>
<body>

    <div class="page">

        <div class="header">
            <h1>PHIẾU MUA HÀNG</h1>
            <div>Số phiếu: PC-0001</div>
        </div>

        <div class="layout">

            <!-- ================= LEFT: FORM ================= -->
            <div>

                <div class="section">
                    <div class="section-title">Thông tin chung</div><!--subject-->
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Ngày nhập</label><!--input date-->
                            <input value="01/01/2026">
                        </div>
                        <div class="form-group">
                            <label>Nhân viên</label> <!--staff id-->
                            <input value="Nguyễn Văn A">
                        </div>
                        <div class="form-group full">
                            <label>Ghi chú</label>
                            <textarea rows="2">Mua hàng phục vụ sản xuất</textarea>
                        </div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">Chi tiết mua hàng</div>
                    <table>
                        <thead>
                            <tr>
                                <th>Mặt hàng</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Vật tư A</td>
                                <td>10</td>
                                <td>50,000</td>
                                <td>500,000</td>
                            </tr>
                            <tr>
                                <td>Vật tư B</td>
                                <td>5</td>
                                <td>100,000</td>
                                <td>500,000</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="total">
                        Tổng cộng: 1,000,000 VND
                    </div>
                </div>

            </div>

            <!-- ================= RIGHT: TIMELINE ================= -->
            <div>

                <div class="section-title">Trạng thái xử lý</div>

                <div class="timeline">

                    <div class="timeline-item approved">
                        <div class="timeline-title">Đã tạo phiếu</div>
                        <div class="timeline-time">01/01/2026 08:30</div>
                        <div class="timeline-note">Nguyễn Văn A</div>
                    </div>

                    <div class="timeline-item pending">
                        <div class="timeline-title">Chờ phê duyệt</div>
                        <div class="timeline-time">01/01/2026 09:00</div>
                        <div class="timeline-note">Phòng Kế toán</div>
                    </div>

                    <div class="timeline-item approved">
                        <div class="timeline-title">Đã phê duyệt</div>
                        <div class="timeline-time">01/01/2026 10:15</div>
                        <div class="timeline-note">Trưởng phòng</div>
                    </div>

                </div>
            </div>

        </div>

    </div>

</body>
</html>
