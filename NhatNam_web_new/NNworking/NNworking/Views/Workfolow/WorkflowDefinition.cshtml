
@{
    ViewBag.Title = "Quy trình phần mềm";
}


@(Html.DevExtreme().DataGrid<NNworking.Models.C222_WorkFolowDefinition>()
    .DataSource(ds => ds.WebApi()
        .RouteName("C222_WorkFolowDefinitionApi")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("ID")
    )
    .ID("dxPartListGrid")
    .Paging(page => page.PageSize(30))
    .Pager(pager => pager.ShowPageSizeSelector(true)
        .ShowInfo(true)
        .AllowedPageSizes(new List<int> { 30, 50, 100, 200 })
    )
    //.OnExporting("onExportingDatagridToExcel").Export(e => e.Enabled(true))
    .Sorting(sort => sort.Mode(GridSortingMode.Multiple)
        .DescendingText("ID")
    )
    .ColumnAutoWidth(true)
    .FilterRow(fil => fil.Visible(true))
    .FilterPanel(fi => fi.Visible(true))
    .SearchPanel(search => search.Visible(true)
        .HighlightSearchText(true)
        .Width(500)
    )
    .Columns(columns => {

        columns.AddFor(m => m.ID).AllowEditing(false);

        columns.AddFor(m => m.WorkflowName).Caption("Tên quy trình");

        columns.AddFor(m => m.Active).Caption("Đang hoạt động");
    })
    .Editing(e => e
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .OnInitNewRow("onInitNewRow")
)

<script>
    function onInitNewRow(e) {
        e.data.ID = 0;
        e.data.Active = true;
    }
</script>


@(Html.DevExtreme().DataGrid<NNworking.Models.C222_WorkFolowDefinition>()
    .DataSource(ds => ds.WebApi()
        .RouteName("C222_WorkFolowDefinitionApi")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("ID")
    )
    .RemoteOperations(true)
    .Columns(columns => {

        columns.AddFor(m => m.ID);

        columns.AddFor(m => m.WorkflowName);

        columns.AddFor(m => m.Active);
    })
    .Editing(e => e
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
)