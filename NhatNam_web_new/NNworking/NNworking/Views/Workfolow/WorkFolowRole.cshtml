
@{
    ViewBag.Title = "Nhóm phê duyệt phần mềm";
}

@(Html.DevExtreme().DataGrid<NNworking.Models.C222_WorkFolowRole>()
    .DataSource(ds => ds.WebApi()
        .RouteName("C222_WorkFolowRoleApi")
        .LoadAction("Get")
        .InsertAction("Post")
        .UpdateAction("Put")
        .DeleteAction("Delete")
        .Key("ID")
    )
    .ID("dxPartListGrid")
    .Paging(page => page.PageSize(30))
    .Pager(pager => pager.ShowPageSizeSelector(true)
        .ShowInfo(true)
        .AllowedPageSizes(new List<int> { 30, 50, 100, 200 })
    )
    //.OnExporting("onExportingDatagridToExcel").Export(e => e.Enabled(true))
    .Sorting(sort => sort.Mode(GridSortingMode.Multiple)
        .DescendingText("ID")
    )
    .ColumnAutoWidth(true)
    .FilterRow(fil => fil.Visible(true))
    .FilterPanel(fi => fi.Visible(true))
    .SearchPanel(search => search.Visible(true)
        .HighlightSearchText(true)
        .Width(500)
    )
    .Columns(columns => {

    columns.AddFor(m => m.ID).AllowEditing(false);

    columns.AddFor(m => m.GroupName).Caption("Tên nhóm");

    columns.AddFor(m => m.StaffID).Caption("Mã nhân viên");

        columns.AddFor(m => m.Note).Caption("Ghi chú");
    })
    .Editing(e => e
        .AllowAdding(true)
        .AllowUpdating(true)
        .AllowDeleting(true)
    )
    .OnInitNewRow("onInitNewRow")
)

<script>
    function onInitNewRow(e) {
        e.data.ID = 0;
    }
</script>