<script>
    let isManager = false;
    let staffDataSource = [];
    let currentForm = null;
    let isRestoringSelections = false;
    let cachedDeptValue = null;
    let cachedStaffValue = null;

    // Cache và restore selection để tránh mất dữ liệu khi reload
    function cacheSelections() {
        const deptSelect = $("#DeptSelect").dxSelectBox("instance");
        const staffSelect = $("#StaffSelect").dxSelectBox("instance");

        if (deptSelect) cachedDeptValue = deptSelect.option("value");
        if (staffSelect) cachedStaffValue = staffSelect.option("value");
    }

    // Restore selections sau khi form update
    function restoreSelections() {
        const deptSelect = $("#DeptSelect").dxSelectBox("instance");
        const staffSelect = $("#StaffSelect").dxSelectBox("instance");

        isRestoringSelections = true;
        try {
            if (deptSelect) {
                deptSelect.option("value", cachedDeptValue);
            }
            if (staffSelect) {
                staffSelect.option("dataSource", staffDataSource || []);
                staffSelect.option("value", cachedStaffValue);
            }
        } finally {
            isRestoringSelections = false;
        }
    }

    $(document).ready(function() {
        loadReviewerInfo();
    });

    // Khởi tạo form với giá trị mặc định (reset all TC fields to 0)
    function onFormInitialized(e) {
        currentForm = e.component;

        if (currentForm.option("formData") && currentForm.option("formData").Id === undefined) {
            const allTcFields = [
                "NV_TC1", "NV_TC2", "NV_TC3", "NV_TC4", "NV_TC5", "NV_TC6", "NV_TC7", "NV_TC8", "NV_TC9", "NV_TC10", "NV_TC11",
                "QL_TC1", "QL_TC2", "QL_TC3", "QL_TC4", "QL_TC5", "QL_TC6", "QL_TC7", "QL_TC8", "QL_TC9"
            ];

            currentForm.beginUpdate();
            allTcFields.forEach(f => currentForm.updateData(f, 0));
            currentForm.updateData("ProcessId", '@Session["StaffID"].ToString()');
            currentForm.endUpdate();
        }
    }

    // Load thông tin reviewer và kiểm tra quyền quản lý
    function loadReviewerInfo() {
        $.ajax({
            url: '@Url.Action("GetReviewerInfo", "api/C222_Evaluation_Reviewer")',
            type: 'GET',
            data: { StaffID: "@Session["StaffID"].ToString()" },
            dataType: 'json',
            success: function(response) {
                if (response && response.success && response.data) {
                    $("#reviewerInfo").show();
                    isManager = response.data.manager;

                    const grid = $("#evaluationGrid").dxDataGrid("instance");
                    grid.option("columns[3].visible", isManager);
                    grid.refresh();
                }
            },
            error: function(xhr, status, error) {
                console.error("Lỗi khi tải thông tin:", error);
            }
        });
    }

    // Xử lý thêm mới đánh giá - lưu dữ liệu đánh giá
    function onRowInserting(e) {
        if (!currentForm) return;

        const formData = currentForm.option("formData");

        $.ajax({
            url: '@Url.Action("Post", "api/C222_Evaluation_Employee")',
            type: 'POST',
            data: {
                values: JSON.stringify(formData)
            },
            success: function(response) {
                if (response && response.Id) {
                    e.cancel = false;
                    location.reload();
                }
            },
            error: function(xhr, status, error) {
                console.error("Lỗi khi thêm dữ liệu:", error);
                e.cancel = true;
            }
        });
    }

    // Xử lý khi thay đổi phòng ban - load nhân viên tương ứng
    function onDeptChanged(e) {
        var deptCode = e.value;
        var staffSelect = $("#StaffSelect").dxSelectBox("instance");
        var secName = '@Session["Department"].ToString()';
        var staffId = '@Session["StaffID"].ToString()';

        if (!deptCode) {
            staffDataSource = [];
            staffSelect.option("dataSource", []);
            return;
        }

        $.ajax({
            url: '@Url.Action("GetByDept", "api/C222_Staff")',
            data: { DeptCode: deptCode, SecName: secName, StaffID: staffId },
            dataType: 'json',
            cache: false,
            success: function(response) {
                if (response && response.data && response.data.length > 0) {
                    staffDataSource = response?.data || [];
                    staffSelect.option("dataSource", response.data);
                } else {
                    staffDataSource = [];
                    staffSelect.option("dataSource", []);
                }
            },
            error: function(err) {
                console.error(err);
                staffDataSource = [];
                staffSelect.option("dataSource", []);
                alert("Lỗi khi tải danh sách nhân viên!");
            }
        });
    }

    // Xử lý khi chọn nhân viên - hiển thị/ẩn tiêu chí quản lý
    function onStaffChanged(e) {
        if (isRestoringSelections) return;
        if (!e || !currentForm) return;

        cachedStaffValue = e.value;
        cacheSelections();

        currentForm.updateData("StaffId", e.value);

        const staff = staffDataSource.find(x => x.StaffID === e.value);
        const isManager = staff?.Manager === true;

        currentForm.beginUpdate();
        currentForm.itemOption("QL_GROUP", "visible", isManager);

        if (!isManager) {
            ["QL_TC1", "QL_TC2", "QL_TC3", "QL_TC4", "QL_TC5", "QL_TC6", "QL_TC7", "QL_TC8", "QL_TC9"]
                .forEach(f => currentForm.updateData(f, 0));
        }

        currentForm.endUpdate();

        setTimeout(function() {
            restoreSelections();
        }, 0);
    }

    // Cập nhật giá trị khi thay đổi tiêu chí đánh giá
    function onTcValueChanged(e) {
        if (!currentForm) return;
        const dataField = e.component.option("name");
        if (dataField) {
            currentForm.updateData(dataField, e.value);
        }
    }

    // Xuất DataGrid ra Excel
    function onExportingDatagridToExcel(e) {
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Danh sách đánh giá');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function() {
            workbook.xlsx.writeBuffer().then(function(buffer) {
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'DanhSachDanhGia.xlsx');
            });
        });
        e.cancel = true;
    }

    // Tính tổng điểm từ tất cả tiêu chí NV và QL
    function calculateTotalScore(rowData) {
        var nvScore = 0;
        var nvFields = ["NV_TC1", "NV_TC2", "NV_TC3", "NV_TC4", "NV_TC5", "NV_TC6", "NV_TC7", "NV_TC8", "NV_TC9", "NV_TC10", "NV_TC11"];
        for (var i = 0; i < nvFields.length; i++) {
            var value = rowData[nvFields[i]];
            if (value && !isNaN(value)) {
                nvScore += parseFloat(value);
            }
        }
        
        var qlScore = 0;
        var qlFields = ["QL_TC1", "QL_TC2", "QL_TC3", "QL_TC4", "QL_TC5", "QL_TC6", "QL_TC7", "QL_TC8", "QL_TC9"];
        for (var i = 0; i < qlFields.length; i++) {
            var value = rowData[qlFields[i]];
            if (value && !isNaN(value)) {
                qlScore += parseFloat(value);
            }
        }
        
        return nvScore + qlScore;
    }

    // Xếp loại nhân viên dựa trên tổng điểm và loại nhân viên
    // Xếp loại dựa trên tổng điểm và vai trò (quản lý/nhân viên)
    function calculateRating(rowData) {
        var score = calculateTotalScore(rowData);
        if (score == null || score === 0) return "";

        var isManager = (rowData.QL_TC1 > 0) || (rowData.QL_TC2 > 0) ||
            (rowData.QL_TC3 > 0) || (rowData.QL_TC4 > 0) ||
            (rowData.QL_TC5 > 0) || (rowData.QL_TC6 > 0) ||
            (rowData.QL_TC7 > 0) || (rowData.QL_TC8 > 0) ||
            (rowData.QL_TC9 > 0);

        if (isManager) {
            if (score >= 85) return "Xuất sắc";
            if (score >= 70) return "Tốt";
            if (score >= 61) return "Khá";
            if (score >= 50) return "Trung bình";
            return "Yếu";
        } else {
            if (score >= 50) return "Xuất sắc";
            if (score >= 40) return "Tốt";
            if (score >= 34) return "Khá";
            if (score >= 25) return "Trung bình";
            return "Yếu";
        }
    }
</script>